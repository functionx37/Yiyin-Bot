# Add only this location to the existing port-80 server for HTTP-01 renewal:
# location ^~ /.well-known/acme-challenge/ {
#     root /var/www/letsencrypt;
#     default_type text/plain;
#     try_files $uri =404;
# }
# Issue a trusted IP certificate using Certbot >=5.4, then enable this server.
# Replace YOUR_PUBLIC_IP with your server's public IP before installing.
server {
    listen 443 ssl;
    server_name YOUR_PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/YOUR_PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    location = /qq/webhook {
        proxy_pass http://127.0.0.1:8080/qq/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Request headers, including QQ's AppID and signature, pass through.
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
