#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
INSTALL_PATH_DEFAULT="/usr/local/bin/yiyin"

usage() {
  cat <<'EOF'
用法:
  yiyin run
  yiyin stop
  yiyin status
  yiyin push [user@host:path]
  yiyin pull [user@host:path]
  yiyin diff [user@host:path]
  sudo ./scripts/yiyin install
  sudo ./scripts/yiyin install /usr/local/bin/yiyin

说明:
  run    启动前检查远端更新，再启动 bot 和 napcat 的 tmux 会话
  stop   停止该 tmux 会话
  status 查看该 tmux 会话是否存在
  push   推送 data/ 到远程
  pull   从远程拉取 data/
  diff   预览本地与远程的 data/ 差异
  install 安装全局命令到 /usr/local/bin/yiyin
EOF
}

install_command() {
  local target="${1:-$INSTALL_PATH_DEFAULT}"
  local target_dir self_quoted

  target_dir="$(dirname "$target")"
  if [[ ! -d "$target_dir" ]]; then
    echo "错误: 目标目录不存在: $target_dir" >&2
    exit 1
  fi

  if [[ ! -w "$target_dir" ]]; then
    echo "错误: 当前用户无法写入 $target_dir" >&2
    echo "请使用 sudo 执行安装，例如:" >&2
    echo "  sudo $SELF_PATH install" >&2
    exit 1
  fi

  printf -v self_quoted '%q' "$SELF_PATH"

  cat >"$target" <<EOF
#!/usr/bin/env bash
exec $self_quoted "\$@"
EOF

  chmod +x "$target"
  echo "已安装全局命令: $target"
  echo "现在可以直接使用:"
  echo "  yiyin run"
  echo "  yiyin stop"
  echo "  yiyin status"
}

COMMAND="${1:-}"

case "$COMMAND" in
  run)
    exec "$SCRIPT_DIR/yiyin-run.sh"
    ;;
  stop)
    exec "$SCRIPT_DIR/yiyin-stop.sh"
    ;;
  status)
    SESSION_NAME="${YIYIN_TMUX_SESSION:-yiyin}"
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
      echo "运行中: $SESSION_NAME"
    else
      echo "未运行: $SESSION_NAME"
    fi
    ;;
  push|pull|diff)
    exec "$SCRIPT_DIR/yiyin-sync.sh" "$@"
    ;;
  install)
    install_command "${2:-}"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "错误: 不支持的命令: $COMMAND" >&2
    usage
    exit 1
    ;;
esac
