# Nginx terminates public HTTPS and proxies /qq/webhook to this local listener.
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]
QQ_VERIFY_WEBHOOK=true

# AppID and AppSecret from the QQ developer console.
# Webhook subscriptions are selected in the QQ console, not through intent.
QQ_BOTS=[{"id":"YOUR_APP_ID","secret":"YOUR_APP_SECRET","use_websocket":false}]
