# WebSocket connects outbound to QQ; no domain or public HTTP service is needed.
DRIVER=~none+~httpx+~websockets
LOG_LEVEL=INFO
COMMAND_START=["/"]

# AppID and AppSecret from the QQ developer console.
# Keep use_websocket=true; only group messages and C2C messages are subscribed.
QQ_BOTS=[{"id":"YOUR_APP_ID","secret":"YOUR_APP_SECRET","use_websocket":true,"intent":{"guilds":false,"guild_members":false,"guild_message_reactions":false,"message_audit":false,"at_messages":false,"c2c_group_at_messages":true}}]
