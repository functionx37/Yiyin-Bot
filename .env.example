# NoneBot2 驱动配置
DRIVER=~fastapi+~httpx+~websockets

# NoneBot2 监听地址和端口
HOST=0.0.0.0
PORT=8080

# meme-generator 资源与配置目录
MEME_HOME=./assets/images/meme_generator

# OneBot 连接令牌（NapCat 中需配置相同的 token）
ONEBOT_ACCESS_TOKEN=your_token_here

# 超级用户 QQ 号（拥有所有管理权限，多个用空格分隔）
SUPERUSERS=["your_qq_id_here"]

# LLM 网关配置
LLM_BASE_URL=your_llm_base_url_here
LLM_API_KEY=your_llm_api_key_here

# ORM 等一机一份数据单独放（不放进 data/），避免同步与权限问题
LOCALSTORE_PLUGIN_DATA_DIR='{"nonebot_plugin_orm": ".local/orm"}'

# data/ 同步默认远程（scripts/sync-data.sh ，格式: user@host:/path/to/Yiyin-Bot）
DATA_SYNC_REMOTE=user@your-server:/path/to/Yiyin-Bot

# /web 插件生成外部访问链接时使用的网站基址，例如：http://your-domain-or-ip
SITE_BASE_URL=http://your-domain-or-ip

# /web 插件生成群网页访问 token 的密钥，需与 Yiyin-Panel 保持一致
WEB_TOKEN_SECRET=change_me

# /web 插件按自然日计算 token 失效时间时使用的时区
TOKEN_TIMEZONE=Asia/Shanghai
