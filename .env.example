# NoneBot2 驱动配置
DRIVER=~fastapi+~httpx+~websockets

# NoneBot2 监听地址和端口（Docker 容器内）
HOST=0.0.0.0
PORT=8080

# meme-generator 资源与配置目录（相对项目根；Docker 内已设）
MEME_HOME=./assets/images/meme_generator

# OneBot 连接令牌（NapCat 中需配置相同的 token）
ONEBOT_ACCESS_TOKEN=your_token_here

# 超级用户 QQ 号（拥有所有管理权限，多个用空格分隔）
SUPERUSERS=["your_qq_id_here"]

# WolframAlpha Full Results API AppID（https://developer.wolframalpha.com）
WOLFRAM_APPID=your_appid_here

# 腾讯云机器翻译 API 密钥（https://console.cloud.tencent.com/cam/capi）
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# 云雾 API 密钥（https://yunwu.ai）— 角色扮演等 LLM 功能
YUNWU_API_KEY=your_yunwu_api_key_here

# ORM 等一机一份数据单独放（不放进 data/），避免同步与权限问题
LOCALSTORE_PLUGIN_DATA_DIR='{"nonebot_plugin_orm": ".local/orm"}'

# data/ 同步默认远程（scripts/sync-data.sh ，格式: user@host:/path/to/Yiyin-Bot）
DATA_SYNC_REMOTE=user@your-server:/path/to/Yiyin-Bot
